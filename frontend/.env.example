# Firebase web app config (Firebase Console > Project Settings > General > Your apps)
# Leave unset to use the local Firebase Auth Emulator demo config.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Set to "false" once you have a real Firebase project configured above.
VITE_USE_FIREBASE_EMULATOR="true"
