# Backend API. Leave unset locally (Vite proxies /api to localhost:5001).
# Production with a separately hosted backend: https://your-api.example.com/api
VITE_API_BASE_URL=""

# Firebase web app config (Firebase Console > Project Settings > General > Your apps)
# Leave unset to use the local Firebase Auth Emulator demo config.
# Format (fake values):
#   VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
#   VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
#   VITE_FIREBASE_PROJECT_ID="your-project-id"
#   VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Set to "false" once you have a real Firebase project configured above.
VITE_USE_FIREBASE_EMULATOR="true"

# Location Finds map tiles (optional). Defaults to the standard OpenStreetMap
# tiles, which are fine for development and light use. For production traffic,
# use a tile provider's XYZ URL and its required attribution (HTML allowed).
VITE_MAP_TILE_URL=""
VITE_MAP_TILE_ATTRIBUTION=""
