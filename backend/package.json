{
  "name": "digi-closet-server",
  "version": "1.0.0",
  "description": "Digi Closet API Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:start": "mkdir -p ~/.digi-closet/mongodb-data ~/.digi-closet/mongodb-logs && mongod --dbpath ~/.digi-closet/mongodb-data --logpath ~/.digi-closet/mongodb-logs/mongo.log --port 27017",
    "db:stop": "killall mongod 2>/dev/null || true",
    "auth:start": "node scripts/auth-emulator.js",
    "auth:save": "firebase emulators:export ../emulator-data --project demo-digi-closet --force",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@gradio/client": "^2.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
