{
  "name": "digi-closet-server",
  "version": "1.0.0",
  "description": "Digi Closet API Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node database/seed.js",
    "db:start": "mkdir -p ~/.digi-closet/mongodb-data ~/.digi-closet/mongodb-logs && mongod --dbpath ~/.digi-closet/mongodb-data --logpath ~/.digi-closet/mongodb-logs/mongo.log --port 27017",
    "db:stop": "killall mongod 2>/dev/null || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
