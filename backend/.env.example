# --- Server ---
PORT=5001
NODE_ENV=development
# Production: the frontend's URL(s), comma-separated, to restrict CORS.
# Leave blank in development to allow any origin.
CLIENT_URL=""

# --- Database (MongoDB) ---
# Local dev: mongodb://127.0.0.1:27017/digi_closet
# Production: use a MongoDB Atlas connection string, e.g. (fake values)
#   mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/digi_closet
MONGODB_URI="mongodb://127.0.0.1:27017/digi_closet"

# --- Firebase Admin (Auth) ---
# DEV: leave FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY blank and set
# FIREBASE_AUTH_EMULATOR_HOST to run against the local Firebase Auth Emulator
# (start it with: firebase emulators:start --only auth --project demo-digi-closet)
#
# PROD: create a Firebase project, generate a service account key
# (Project Settings > Service Accounts > Generate new private key) and fill
# in the three FIREBASE_* values below. Remove FIREBASE_AUTH_EMULATOR_HOST.
# Format (fake values):
#   FIREBASE_PROJECT_ID="your-project-id"
#   FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID="demo-digi-closet"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# --- AI provider (chat, wardrobe scan, Fashion Critic, colour analysis, outfits) ---
# "groq" (default) or "gemini". AI endpoints return a clear error when the
# chosen provider's key is missing; there is no mock mode.
AI_PROVIDER="groq"

# --- Groq ---
# Get a key at https://console.groq.com/keys
# Format (fake): gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_API_KEY=""
# Text models (the fallback is used when the primary is rate limited).
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
# Model for requests with a photo; it must accept image input.
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_VISION_FALLBACK_MODEL=""

# --- Gemini AI (optional) ---
# Used when AI_PROVIDER="gemini", and for try-on images when "gemini" is in
# IMAGE_GENERATION_PROVIDERS. Get a key at https://aistudio.google.com/app/apikey
# Format (fake): AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=""
# Optional. The fallback model is used when the primary is overloaded (503/429)
# or has no quota. Both defaults are Flash-Lite models, which the free tier covers.
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# --- Weather (Open-Meteo: free, no key required) ---
WEATHER_PROVIDER="open-meteo"

# --- Location Finds (OpenStreetMap: free, no key required) ---
# Nearby fashion stores come from the Overpass API; typed cities / PIN codes
# are looked up with Nominatim. Public Overpass servers are often at capacity,
# so several instances (comma-separated) are tried in order. Point these at a
# self-hosted or commercial instance for heavy traffic. Their usage policies
# ask for an identifying User-Agent: add a contact URL for your deployment.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"
OSM_USER_AGENT="DigiCloset/1.0 (location-finds)"

# --- Product Search (Smart Clothes Finder & budget shopping) ---
# Live listings come from Google Shopping via SerpApi (https://serpapi.com).
# Without a key the finder still parses requests with Gemini and links to
# marketplace searches, but shows no product listings or prices.
PRODUCT_SEARCH_PROVIDER="serpapi"
# Format (fake): a 64-character key from serpapi.com > Dashboard.
PRODUCT_SEARCH_API_KEY=""

# --- AI image generation (Virtual Try-On & Style Makeover) ---
# Providers are tried in order; the next one is used only when the current
# one can't serve requests (no quota, down, timed out).
#   gemini      - uses GEMINI_API_KEY. Image models need billing enabled on the
#                 key's Google Cloud project (roughly US$0.04-0.07 per 1K
#                 image). On a free key they report zero quota and are skipped.
#   huggingface - free, public Hugging Face Spaces (ZeroGPU). Slower (often
#                 30-90 s, longer when queued) and limited by a daily GPU quota.
#   openrouter  - paid fallback via OPENROUTER_API_KEY (prepaid credits,
#                 roughly US$0.04 per image). Skipped when the key is blank.
# The older single-value IMAGE_GENERATION_PROVIDER is still read if this is unset.
IMAGE_GENERATION_PROVIDERS="gemini,huggingface,openrouter"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
GEMINI_IMAGE_FALLBACK_MODEL="gemini-2.5-flash-image"

# Optional free token (https://huggingface.co/settings/tokens, "read" scope):
# raises the ZeroGPU quota compared with anonymous use. Format (fake): hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
HF_TOKEN=""
# Virtual try-on Space (person photo + one top/outerwear/dress photo).
HF_TRYON_SPACE="yisol/IDM-VTON"
# Instruction-based image editor (makeovers and multi-item try-on).
HF_EDIT_SPACE="black-forest-labs/FLUX.1-Kontext-Dev"
# Max wait for one Space call, including queueing.
HF_TIMEOUT_MS=180000

# OpenRouter key (https://openrouter.ai/settings/keys). Format (fake): sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_API_KEY=""
# Image models tried in order (https://openrouter.ai/models, output: image).
OPENROUTER_IMAGE_MODELS="google/gemini-3.1-flash-image,google/gemini-2.5-flash-image"
OPENROUTER_TIMEOUT_MS=120000

# How long a model/Space that reported zero quota is skipped (default 1 hour).
AI_QUOTA_COOLDOWN_MS=3600000

# --- Image storage (wardrobe/try-on uploads) ---
# Leave both blank locally: images are saved to backend/uploads/.
# Production needs one of them, because hosts like Render wipe their disk.
# Cloudinary (free, no card): Dashboard > API Keys > "API environment variable".
# Format (fake): cloudinary://123456789012345:YOUR_API_SECRET@your-cloud-name
CLOUDINARY_URL=""
# Or Firebase Storage (needs the Blaze plan). Ignored when CLOUDINARY_URL is set.
FIREBASE_STORAGE_BUCKET=""
