# --- Server ---
PORT=5001
NODE_ENV=development

# --- Database (MongoDB) ---
# Local dev: mongodb://127.0.0.1:27017/digi_closet
# Production: use a MongoDB Atlas connection string
MONGODB_URI="mongodb://127.0.0.1:27017/digi_closet"

# --- Firebase Admin (Auth) ---
# DEV: leave FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY blank and set
# FIREBASE_AUTH_EMULATOR_HOST to run against the local Firebase Auth Emulator
# (start it with: firebase emulators:start --only auth --project demo-digi-closet)
#
# PROD: create a Firebase project, generate a service account key
# (Project Settings > Service Accounts > Generate new private key) and fill
# in the three FIREBASE_* values below. Remove FIREBASE_AUTH_EMULATOR_HOST.
FIREBASE_PROJECT_ID="demo-digi-closet"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# --- Gemini AI ---
# Get a key at https://aistudio.google.com/app/apikey
# Leave blank to run AI features in transparent offline-fallback mode.
GEMINI_API_KEY=""

# --- Weather (Open-Meteo: free, no key required) ---
WEATHER_PROVIDER="open-meteo"

# --- Product Search / Shopping ---
# No real shopping feed is configured. The app falls back to a clearly
# labeled "Development Catalog" seeded in MongoDB. Set this once a licensed
# product search / affiliate API is available.
PRODUCT_SEARCH_API_KEY=""

# --- Virtual Try-On ---
# No provider configured. The feature boundary (upload, job tracking,
# status) works, but requests will return status "awaiting_configuration"
# until these are set.
VIRTUAL_TRYON_API_KEY=""
VIRTUAL_TRYON_PROVIDER_URL=""

# --- Firebase Storage (optional, for wardrobe/try-on image uploads) ---
FIREBASE_STORAGE_BUCKET=""
